# =============================================================================
# Odoo.sh -> AWS Migration : Central Configuration
# -----------------------------------------------------------------------------
# Copy this file to  config.env  and fill in every value marked <CHANGE_ME>.
# All scripts source this single file, so there is one source of truth.
#
#     cp config.env.example config.env
#     chmod 600 config.env          # contains secrets - keep it private
#
# NEVER commit config.env to git. It is already in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# 0. GLOBAL / PROJECT
# -----------------------------------------------------------------------------
PROJECT_NAME="syncoria-odoo"                 # prefix used for every AWS tag/name
AWS_REGION="us-east-2"                        # US East (Ohio) - per spec
AWS_PROFILE="default"                         # aws cli named profile to use
AWS_AZ="us-east-2a"                           # single AZ for both boxes

# The migration runs across TWO environments under the same AWS project.
# Loop over these when a step must run for both.
ENVIRONMENTS=("production" "staging")

# -----------------------------------------------------------------------------
# 1. NETWORK  (created by 01-provision-aws.sh, shared by both environments)
# -----------------------------------------------------------------------------
VPC_CIDR="10.20.0.0/16"
SUBNET_CIDR="10.20.1.0/24"

# CIDRs allowed to reach SSH (22). Lock this to your office / VPN.
# NEVER leave 0.0.0.0/0 for SSH in production.
ADMIN_ALLOWED_CIDR="<CHANGE_ME_e.g._203.0.113.10/32>"

# CIDRs allowed to reach HTTPS (443). Public site => 0.0.0.0/0.
WEB_ALLOWED_CIDR="0.0.0.0/0"

# EC2 key pair. If the named key does not exist the provision script creates it
# and drops the private key at  ./secrets/<KEY_NAME>.pem
EC2_KEY_NAME="${PROJECT_NAME}-key"

# AMI: leave AUTO to resolve the latest Ubuntu 22.04 LTS (x86_64) via SSM.
EC2_AMI_ID="AUTO"
SSH_USER="ubuntu"

# -----------------------------------------------------------------------------
# 2. PER-ENVIRONMENT EC2 SPEC   (exactly as provided in the migration brief)
# -----------------------------------------------------------------------------
# Production
PRODUCTION_INSTANCE_TYPE="t3.large"
PRODUCTION_EBS_GB="1000"
PRODUCTION_MONITORING="enabled"              # detailed CloudWatch monitoring ON
PRODUCTION_TENANCY="default"                 # "Shared Instances"
PRODUCTION_DOMAIN="<CHANGE_ME_erp.example.com>"

# Staging
STAGING_INSTANCE_TYPE="t3.medium"
STAGING_EBS_GB="1000"
STAGING_MONITORING="disabled"                # detailed monitoring OFF
STAGING_TENANCY="default"                    # "Shared Instances"
STAGING_DOMAIN="<CHANGE_ME_staging.example.com>"

# EBS volume type (gp3 = best price/perf for a 1000GB data volume)
EBS_VOLUME_TYPE="gp3"

# -----------------------------------------------------------------------------
# 3. ODOO  (used by 02-deploy-odoo.sh and 03-migrate-from-odoosh.sh)
# -----------------------------------------------------------------------------
# Target Odoo version = THE control parameter. Both 18.0 and 19.0 are supported.
# Default here, but override per-run without editing this file, e.g.:
#     ODOO_VERSION=18.0 ./02-deploy-odoo.sh
#     ODOO_VERSION=19.0 ./02-deploy-odoo.sh
# NOTE: the target must be >= the odoo.sh source version. A newer DB (e.g. 19.0)
# cannot be restored onto an older codebase (e.g. 18.0).
ODOO_VERSION="${ODOO_VERSION:-19.0}"
ODOO_EDITION="enterprise"
ODOO_USER="odoo"
ODOO_HOME="/opt/odoo"
ODOO_CONF="/etc/odoo/odoo.conf"
ODOO_ENTERPRISE_ADDONS="/opt/odoo/enterprise"
ODOO_CUSTOM_ADDONS="/opt/odoo/custom-addons"
ODOO_FILESTORE="/var/lib/odoo/filestore"     # data_dir=/var/lib/odoo => filestore/<db>

# Odoo Enterprise source. Cloning odoo/enterprise requires a GitHub account that
# Odoo S.A. has granted access to (it is a private repo).
# Provide a Personal Access Token (classic, repo scope).
ODOO_ENTERPRISE_GIT="https://github.com/odoo/enterprise.git"
GITHUB_USER="<CHANGE_ME_github_user>"
GITHUB_TOKEN="<CHANGE_ME_github_pat_with_enterprise_access>"

# Master / admin password written to odoo.conf (database manager password).
# Generated randomly if left as AUTO.
ODOO_ADMIN_PASSWD="AUTO"

# PostgreSQL (local on the same box, per requirement)
PG_VERSION="16"
PG_ODOO_DB_USER="odoo"
PG_ODOO_DB_PASSWORD="AUTO"                    # AUTO => generated & stored in secrets/

# -----------------------------------------------------------------------------
# 4. ODOO.SH SOURCE  (used by 03-migrate-from-odoosh.sh - automated pull)
# -----------------------------------------------------------------------------
# The odoo.sh project repository (contains your custom addons on its branches).
ODOOSH_REPO_URL="<CHANGE_ME_git@github.com:org/odoo-project.git>"

# Which odoo.sh branch maps to which target environment.
ODOOSH_PROD_BRANCH="production"
ODOOSH_STAGING_BRANCH="staging"

# odoo.sh exposes a per-branch SSH build host and downloadable backups.
#   ODOOSH_*_SSH_HOST : SSH host from odoo.sh > Branch > (top-right) > SSH
#                       e.g. <build-id>@<region>.odoo.sh
#   ODOOSH_*_DUMP_URL : signed backup .zip URL from
#                       odoo.sh > Branch > Backups > Download (copy link).
#                       These URLs are time-limited; refresh right before running.
ODOOSH_PROD_SSH_HOST="<CHANGE_ME_prod_build@x.odoo.sh>"
ODOOSH_STAGING_SSH_HOST="<CHANGE_ME_staging_build@x.odoo.sh>"

# Pull method:
#   "ssh_dump"     - pull dump+filestore over SSH from the odoo.sh build container
#                    (needs SSH key + the right role; production SSH is often
#                    admin-only on odoo.sh).
#   "https_backup" - download a .zip backup from a URL with curl (only works if
#                    the URL is a real signed token, NOT a session-authed link).
#   "local_file"   - MOST RELIABLE when SSH/role blocks you: download the backup
#                    .zip from odoo.sh in your browser (Branch > Backups >
#                    Download), then point the *_DUMP_FILE vars at the local
#                    files. They are uploaded to the target box and restored.
ODOOSH_PULL_METHOD="ssh_dump"

# Only used when ODOOSH_PULL_METHOD="https_backup"
ODOOSH_PROD_DUMP_URL="<CHANGE_ME_signed_backup_zip_url>"
ODOOSH_STAGING_DUMP_URL="<CHANGE_ME_signed_backup_zip_url>"

# Only used when ODOOSH_PULL_METHOD="local_file" (paths on THIS machine)
ODOOSH_PROD_DUMP_FILE=""
ODOOSH_STAGING_DUMP_FILE=""

# SSH private key that odoo.sh recognises (added under odoo.sh account settings).
ODOOSH_SSH_KEY="./secrets/odoosh_id_ed25519"

# Source database names on odoo.sh (the pg database name of each branch).
ODOOSH_PROD_DBNAME="<CHANGE_ME_prod_dbname>"
ODOOSH_STAGING_DBNAME="<CHANGE_ME_staging_dbname>"

# Target database name created on AWS.
TARGET_PROD_DBNAME="odoo_prod"
TARGET_STAGING_DBNAME="odoo_staging"

# Staging neutralization: strip mail servers, crons, payment creds, etc.
# Strongly recommended TRUE so staging can never email real customers.
NEUTRALIZE_STAGING="true"

# Post-restore module reconcile. The odoo.sh backup may lag the deployed addon
# code (new fields => missing columns); "odoo-bin -u <this>" creates them.
#   "all"  - update every installed module (most thorough; recommended)
#   "off"  - skip (only if backup and code are known identical)
#   or a comma-list of modules, e.g. "os_payment,syncoria_can_payroll"
RECONCILE_MODULES="all"

# -----------------------------------------------------------------------------
# 5. HARDENING / TLS  (used by 04-harden-and-tune.sh)
# -----------------------------------------------------------------------------
# Origin TLS mode:
#   "letsencrypt"       - certbot issues a public cert (domain must point DIRECTLY
#                         at this box, i.e. Cloudflare DNS-only / grey cloud).
#   "cloudflare_origin" - install a Cloudflare Origin Certificate on nginx; use
#                         when the domain is PROXIED through Cloudflare (orange
#                         cloud) with SSL mode Full or Full (strict).
TLS_MODE="cloudflare_origin"

# For TLS_MODE=cloudflare_origin: local paths to the Origin cert + key you saved
# from Cloudflare (SSL/TLS > Origin Server). One cert can cover *.syncoria.tech.
TLS_ORIGIN_CERT_FILE="./secrets/cf-origin.pem"
TLS_ORIGIN_KEY_FILE="./secrets/cf-origin.key"

# When proxied through Cloudflare, lock origin 80/443 to Cloudflare IP ranges so
# nobody can bypass the proxy and hit the box directly. Applied by 04.
RESTRICT_WEB_TO_CLOUDFLARE="true"

LETSENCRYPT_EMAIL="<CHANGE_ME_ops@example.com>"   # only used when TLS_MODE=letsencrypt
ENABLE_FAIL2BAN="true"
ENABLE_UFW="true"
ENABLE_UNATTENDED_UPGRADES="true"

# Nightly local backup retention (days). Backups written to /opt/odoo/backups.
BACKUP_RETENTION_DAYS="7"
# Optional: push nightly backups to S3. Leave empty to disable.
BACKUP_S3_BUCKET=""

# SSH hardening
SSH_DISABLE_PASSWORD_AUTH="true"
SSH_DISABLE_ROOT_LOGIN="true"

# =============================================================================
# End of configuration
# =============================================================================
